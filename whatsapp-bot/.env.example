# Copie para .env e preencha. Nunca commitar o .env de verdade.

SUPABASE_URL=https://gbcludivekunlteudaok.supabase.co

# A service role key (não a anon/publishable) — é ela que deixa o bot
# escrever na tabela whatsapp_conexao ignorando a RLS (que só permite
# leitura por admin). Pegue em: Supabase → Project Settings → API →
# service_role secret. NUNCA coloque essa chave no app React/Vite nem em
# qualquer código que rode no navegador — só aqui, num processo de servidor.
SUPABASE_SERVICE_ROLE_KEY=
